from __future__ import annotations

import os
from dataclasses import dataclass


DEFAULT_API_TITLE = "Adaptive Mission UI API"

# ROS API of adaptive_mission_mode_simple:
#   /adaptive_mission_mode/mission_json : std_msgs/msg/String
#   /adaptive_mission_mode/activate     : std_msgs/msg/Bool
#   /adaptive_mission_mode/pickup       : std_msgs/msg/String
#   /adaptive_mission_mode/pause_rtl    : std_msgs/msg/Bool
#   /adaptive_mission_mode/continue_mission : std_msgs/msg/Bool
DEFAULT_MISSION_TOPIC = "/adaptive_mission_mode/mission_json"
DEFAULT_ACTIVATE_TOPIC = "/adaptive_mission_mode/activate"
DEFAULT_PICKUP_TOPIC = "/adaptive_mission_mode/pickup"
DEFAULT_PAUSE_RTL_TOPIC = "/adaptive_mission_mode/pause_rtl"
DEFAULT_CONTINUE_MISSION_TOPIC = "/adaptive_mission_mode/continue_mission"

# Deprecated compatibility names. Old backend/frontend used /start and /return_home.
# They now map to the new /activate topic.
DEFAULT_START_TOPIC = DEFAULT_ACTIVATE_TOPIC
DEFAULT_RETURN_HOME_TOPIC = DEFAULT_ACTIVATE_TOPIC

# The simple ROS mode does not publish a runtime status topic. Keep this optional
# so an older richer mode can still be monitored by setting the environment var.
DEFAULT_MISSION_STATUS_TOPIC = ""
DEFAULT_STATUS_TIMEOUT_S = 3.0
DEFAULT_START_DELAY_S = 0.25
DEFAULT_VEHICLE_STATUS_TOPIC = "/fmu/out/vehicle_status"
DEFAULT_VEHICLE_GLOBAL_POSITION_TOPIC = "/fmu/out/vehicle_global_position"
DEFAULT_VEHICLE_LOCAL_POSITION_TOPIC = "/fmu/out/vehicle_local_position"
DEFAULT_BATTERY_STATUS_TOPIC = "/fmu/out/battery_status"
DEFAULT_MAP_ORIGIN_LAT_DEG = 10.823099
DEFAULT_MAP_ORIGIN_LON_DEG = 106.629662
DEFAULT_MAP_ORIGIN_ALT_MSL_M = 0.0

DEFAULT_MAVLINK_ENABLED = True
DEFAULT_MAVLINK_CONNECTION_URL = "udpin:0.0.0.0:14550"
DEFAULT_MAVLINK_HEARTBEAT_HZ = 1.0
DEFAULT_MAVLINK_TIMEOUT_S = 3.0
DEFAULT_MAVLINK_SOURCE_SYSTEM = 255
DEFAULT_MAVLINK_SOURCE_COMPONENT = 190
DEFAULT_MAVLINK_REQUEST_STREAMS = True


def _parse_origins(raw_value: str) -> list[str]:
    return [origin.strip() for origin in raw_value.split(",") if origin.strip()]


@dataclass(slots=True)
class AppSettings:
    api_title: str = DEFAULT_API_TITLE
    cors_origins: list[str] = None  # type: ignore[assignment]
    mission_topic: str = DEFAULT_MISSION_TOPIC
    activate_topic: str = DEFAULT_ACTIVATE_TOPIC
    pickup_topic: str = DEFAULT_PICKUP_TOPIC
    pause_rtl_topic: str = DEFAULT_PAUSE_RTL_TOPIC
    continue_mission_topic: str = DEFAULT_CONTINUE_MISSION_TOPIC
    mission_status_topic: str = DEFAULT_MISSION_STATUS_TOPIC
    vehicle_status_topic: str = DEFAULT_VEHICLE_STATUS_TOPIC
    vehicle_global_position_topic: str = DEFAULT_VEHICLE_GLOBAL_POSITION_TOPIC
    vehicle_local_position_topic: str = DEFAULT_VEHICLE_LOCAL_POSITION_TOPIC
    battery_status_topic: str = DEFAULT_BATTERY_STATUS_TOPIC
    map_origin_lat_deg: float = DEFAULT_MAP_ORIGIN_LAT_DEG
    map_origin_lon_deg: float = DEFAULT_MAP_ORIGIN_LON_DEG
    map_origin_alt_msl_m: float = DEFAULT_MAP_ORIGIN_ALT_MSL_M
    vehicle_status_timeout_s: float = DEFAULT_STATUS_TIMEOUT_S
    start_delay_s: float = DEFAULT_START_DELAY_S
    mavlink_enabled: bool = DEFAULT_MAVLINK_ENABLED
    mavlink_connection_url: str = DEFAULT_MAVLINK_CONNECTION_URL
    mavlink_heartbeat_hz: float = DEFAULT_MAVLINK_HEARTBEAT_HZ
    mavlink_timeout_s: float = DEFAULT_MAVLINK_TIMEOUT_S
    mavlink_source_system: int = DEFAULT_MAVLINK_SOURCE_SYSTEM
    mavlink_source_component: int = DEFAULT_MAVLINK_SOURCE_COMPONENT
    mavlink_request_streams: bool = DEFAULT_MAVLINK_REQUEST_STREAMS

    @property
    def start_topic(self) -> str:
        """Deprecated alias kept so the old UI can display a start topic."""
        return self.activate_topic

    @property
    def return_home_topic(self) -> str:
        """Deprecated alias kept so the old UI can display a return topic."""
        return self.activate_topic

    @classmethod
    def load(cls) -> "AppSettings":
        raw_origins = os.getenv("MISSION_UI_CORS_ORIGINS", "http://localhost:5173")
        activate_topic = os.getenv(
            "MISSION_UI_ACTIVATE_TOPIC",
            os.getenv("MISSION_UI_START_TOPIC", DEFAULT_ACTIVATE_TOPIC),
        )

        return cls(
            api_title=os.getenv("MISSION_UI_API_TITLE", DEFAULT_API_TITLE),
            cors_origins=_parse_origins(raw_origins),
            mission_topic=os.getenv("MISSION_UI_MISSION_TOPIC", DEFAULT_MISSION_TOPIC),
            activate_topic=activate_topic,
            pickup_topic=os.getenv("MISSION_UI_PICKUP_TOPIC", DEFAULT_PICKUP_TOPIC),
            pause_rtl_topic=os.getenv("MISSION_UI_PAUSE_RTL_TOPIC", DEFAULT_PAUSE_RTL_TOPIC),
            continue_mission_topic=os.getenv("MISSION_UI_CONTINUE_MISSION_TOPIC", DEFAULT_CONTINUE_MISSION_TOPIC),
            mission_status_topic=os.getenv(
                "MISSION_UI_MISSION_STATUS_TOPIC",
                DEFAULT_MISSION_STATUS_TOPIC,
            ),
            vehicle_status_topic=os.getenv(
                "MISSION_UI_VEHICLE_STATUS_TOPIC",
                DEFAULT_VEHICLE_STATUS_TOPIC,
            ),
            vehicle_global_position_topic=os.getenv(
                "MISSION_UI_VEHICLE_GLOBAL_POSITION_TOPIC",
                DEFAULT_VEHICLE_GLOBAL_POSITION_TOPIC,
            ),
            vehicle_local_position_topic=os.getenv(
                "MISSION_UI_VEHICLE_LOCAL_POSITION_TOPIC",
                DEFAULT_VEHICLE_LOCAL_POSITION_TOPIC,
            ),
            battery_status_topic=os.getenv(
                "MISSION_UI_BATTERY_STATUS_TOPIC",
                DEFAULT_BATTERY_STATUS_TOPIC,
            ),
            map_origin_lat_deg=float(
                os.getenv("MISSION_UI_MAP_ORIGIN_LAT_DEG", DEFAULT_MAP_ORIGIN_LAT_DEG)
            ),
            map_origin_lon_deg=float(
                os.getenv("MISSION_UI_MAP_ORIGIN_LON_DEG", DEFAULT_MAP_ORIGIN_LON_DEG)
            ),
            map_origin_alt_msl_m=float(
                os.getenv("MISSION_UI_MAP_ORIGIN_ALT_MSL_M", DEFAULT_MAP_ORIGIN_ALT_MSL_M)
            ),
            vehicle_status_timeout_s=float(
                os.getenv("MISSION_UI_VEHICLE_STATUS_TIMEOUT_S", DEFAULT_STATUS_TIMEOUT_S)
            ),
            start_delay_s=float(os.getenv("MISSION_UI_START_DELAY_S", DEFAULT_START_DELAY_S)),
            mavlink_enabled=os.getenv("MISSION_UI_MAVLINK_ENABLED", "1").lower()
            not in {"0", "false", "no", "off"},
            mavlink_connection_url=os.getenv(
                "MISSION_UI_MAVLINK_CONNECTION",
                DEFAULT_MAVLINK_CONNECTION_URL,
            ),
            mavlink_heartbeat_hz=float(
                os.getenv("MISSION_UI_MAVLINK_HEARTBEAT_HZ", DEFAULT_MAVLINK_HEARTBEAT_HZ)
            ),
            mavlink_timeout_s=float(
                os.getenv("MISSION_UI_MAVLINK_TIMEOUT_S", DEFAULT_MAVLINK_TIMEOUT_S)
            ),
            mavlink_source_system=int(
                os.getenv("MISSION_UI_MAVLINK_SOURCE_SYSTEM", DEFAULT_MAVLINK_SOURCE_SYSTEM)
            ),
            mavlink_source_component=int(
                os.getenv("MISSION_UI_MAVLINK_SOURCE_COMPONENT", DEFAULT_MAVLINK_SOURCE_COMPONENT)
            ),
            mavlink_request_streams=os.getenv(
                "MISSION_UI_MAVLINK_REQUEST_STREAMS", "1"
            ).lower()
            not in {"0", "false", "no", "off"},
        )
