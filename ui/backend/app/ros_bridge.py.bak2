from __future__ import annotations

import json
import math
import threading
import time
from dataclasses import dataclass
from datetime import datetime, timezone
from typing import Any

import rclpy
from px4_msgs.msg import BatteryStatus, VehicleGlobalPosition, VehicleLocalPosition, VehicleStatus
from rclpy.executors import ExternalShutdownException, SingleThreadedExecutor
from rclpy.node import Node
from rclpy.qos import HistoryPolicy, QoSProfile, ReliabilityPolicy
from std_msgs.msg import Bool, String

from .config import AppSettings
from .models import (
    MissionCacheSnapshot,
    MissionRuntimeSnapshot,
    MissionRuntimeVehicleSnapshot,
    PayloadServoSnapshot,
    PauseSnapshot,
    PickupSnapshot,
    PositionSnapshot,
    StatusSnapshot,
    TargetSnapshot,
    VehicleSnapshot,
)


def _utcnow_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def _age_seconds(timestamp: float | None) -> float | None:
    if timestamp is None:
        return None
    return max(time.monotonic() - timestamp, 0.0)


NAV_STATE_NAMES = {
    VehicleStatus.NAVIGATION_STATE_MANUAL: "Manual",
    VehicleStatus.NAVIGATION_STATE_ALTCTL: "Altitude",
    VehicleStatus.NAVIGATION_STATE_POSCTL: "Position",
    VehicleStatus.NAVIGATION_STATE_AUTO_MISSION: "Mission",
    VehicleStatus.NAVIGATION_STATE_AUTO_LOITER: "Hold",
    VehicleStatus.NAVIGATION_STATE_AUTO_RTL: "RTL",
    VehicleStatus.NAVIGATION_STATE_DESCEND: "Descend",
    VehicleStatus.NAVIGATION_STATE_OFFBOARD: "Offboard",
    VehicleStatus.NAVIGATION_STATE_STAB: "Stabilized",
    VehicleStatus.NAVIGATION_STATE_AUTO_TAKEOFF: "Takeoff",
    VehicleStatus.NAVIGATION_STATE_AUTO_LAND: "Land",
    VehicleStatus.NAVIGATION_STATE_AUTO_PRECLAND: "Precision Land",
    VehicleStatus.NAVIGATION_STATE_EXTERNAL1: "External Mode 1",
    VehicleStatus.NAVIGATION_STATE_EXTERNAL2: "External Mode 2",
    VehicleStatus.NAVIGATION_STATE_EXTERNAL3: "External Mode 3",
    VehicleStatus.NAVIGATION_STATE_EXTERNAL4: "External Mode 4",
    VehicleStatus.NAVIGATION_STATE_EXTERNAL5: "External Mode 5",
    VehicleStatus.NAVIGATION_STATE_EXTERNAL6: "External Mode 6",
    VehicleStatus.NAVIGATION_STATE_EXTERNAL7: "External Mode 7",
    VehicleStatus.NAVIGATION_STATE_EXTERNAL8: "External Mode 8",
}


@dataclass(slots=True)
class _Cache:
    mission_name: str | None = None
    item_count: int = 0
    last_mission_publish_at: str | None = None
    last_activate_publish_at: str | None = None
    last_abort_publish_at: str | None = None
    last_start_publish_at: str | None = None
    last_return_home_publish_at: str | None = None
    last_pause_rtl_publish_at: str | None = None
    last_continue_publish_at: str | None = None
    vehicle_status: VehicleStatus | None = None
    vehicle_status_time: float | None = None
    vehicle_global_position: VehicleGlobalPosition | None = None
    vehicle_global_position_time: float | None = None
    global_origin_lat_deg: float | None = None
    global_origin_lon_deg: float | None = None
    global_origin_alt_msl_m: float | None = None
    vehicle_local_position: VehicleLocalPosition | None = None
    vehicle_local_position_time: float | None = None
    battery_status: BatteryStatus | None = None
    battery_status_time: float | None = None
    mission_runtime: dict[str, Any] | None = None
    mission_runtime_time: float | None = None
    pickup_payload: dict[str, Any] | None = None
    pickup_raw: str | None = None
    pickup_time: float | None = None
    pickup_at: str | None = None


class RosMissionBridge:
    """Bridge between FastAPI and the simplified adaptive_mission_mode ROS API."""

    def __init__(self, settings: AppSettings):
        self._settings = settings
        self._lock = threading.Lock()
        self._cache = _Cache()
        self._node: Node | None = None
        self._executor: SingleThreadedExecutor | None = None
        self._thread: threading.Thread | None = None
        self._stop_event = threading.Event()
        self._mission_pub = None
        self._activate_pub = None
        self._pause_rtl_pub = None
        self._continue_mission_pub = None

    def start(self) -> None:
        if self._thread and self._thread.is_alive():
            return

        if not rclpy.ok():
            rclpy.init(args=None)

        self._node = Node("adaptive_mission_ui_bridge")
        self._executor = SingleThreadedExecutor()
        self._executor.add_node(self._node)

        sensor_qos = QoSProfile(
            history=HistoryPolicy.KEEP_LAST,
            depth=10,
            reliability=ReliabilityPolicy.BEST_EFFORT,
        )
        command_qos = QoSProfile(
            history=HistoryPolicy.KEEP_LAST,
            depth=10,
            reliability=ReliabilityPolicy.RELIABLE,
        )

        self._mission_pub = self._node.create_publisher(
            String,
            self._settings.mission_topic,
            command_qos,
        )
        self._activate_pub = self._node.create_publisher(
            Bool,
            self._settings.activate_topic,
            command_qos,
        )
        self._pause_rtl_pub = self._node.create_publisher(
            Bool,
            self._settings.pause_rtl_topic,
            command_qos,
        )
        self._continue_mission_pub = self._node.create_publisher(
            Bool,
            self._settings.continue_mission_topic,
            command_qos,
        )

        self._node.create_subscription(
            VehicleStatus,
            self._settings.vehicle_status_topic,
            self._on_vehicle_status,
            sensor_qos,
        )
        self._node.create_subscription(
            VehicleGlobalPosition,
            self._settings.vehicle_global_position_topic,
            self._on_vehicle_global_position,
            sensor_qos,
        )
        self._node.create_subscription(
            VehicleLocalPosition,
            self._settings.vehicle_local_position_topic,
            self._on_vehicle_local_position,
            sensor_qos,
        )
        self._node.create_subscription(
            BatteryStatus,
            self._settings.battery_status_topic,
            self._on_battery_status,
            sensor_qos,
        )
        self._node.create_subscription(
            String,
            self._settings.pickup_topic,
            self._on_pickup,
            command_qos,
        )

        if self._settings.mission_status_topic:
            self._node.create_subscription(
                String,
                self._settings.mission_status_topic,
                self._on_mission_runtime,
                command_qos,
            )

        self._stop_event.clear()
        self._thread = threading.Thread(
            target=self._spin,
            name="adaptive-mission-ui-ros",
            daemon=True,
        )
        self._thread.start()

    def shutdown(self) -> None:
        self._stop_event.set()
        if self._executor is not None:
            self._executor.shutdown()
        if self._thread is not None:
            self._thread.join(timeout=2.0)
        if self._node is not None:
            self._node.destroy_node()
        self._thread = None
        self._executor = None
        self._node = None
        self._mission_pub = None
        self._activate_pub = None
        self._pause_rtl_pub = None
        self._continue_mission_pub = None
        if rclpy.ok():
            rclpy.shutdown()

    def publish_mission(self, mission_payload: dict[str, Any], mission_name: str, item_count: int) -> None:
        if self._mission_pub is None:
            raise RuntimeError("ROS bridge is not running")

        message = String()
        message.data = json.dumps(mission_payload, separators=(",", ":"))
        self._mission_pub.publish(message)

        with self._lock:
            self._cache.mission_name = mission_name
            self._cache.item_count = item_count
            self._cache.last_mission_publish_at = _utcnow_iso()

    def publish_activate(self, active: bool, *, mark_return_home: bool = False) -> None:
        if self._activate_pub is None:
            raise RuntimeError("ROS bridge is not running")

        message = Bool()
        message.data = bool(active)
        self._activate_pub.publish(message)

        now = _utcnow_iso()
        with self._lock:
            if active:
                self._cache.last_activate_publish_at = now
                self._cache.last_start_publish_at = now
            else:
                self._cache.last_abort_publish_at = now
                if mark_return_home:
                    self._cache.last_return_home_publish_at = now

    def publish_start(self) -> None:
        # Compatibility wrapper. New ROS API uses activate=true.
        self.publish_activate(True)

    def publish_abort(self) -> None:
        # New ROS API uses activate=false to abort the mission.
        self.publish_activate(False)

    def publish_return_home(self) -> None:
        # Compatibility wrapper. The new pause/RTL workflow should use
        # publish_pause_rtl(); keep this only for older UI endpoints.
        self.publish_activate(False, mark_return_home=True)

    def publish_pause_rtl(self) -> None:
        if self._pause_rtl_pub is None:
            raise RuntimeError("ROS bridge is not running")
        message = Bool()
        message.data = True
        self._pause_rtl_pub.publish(message)
        with self._lock:
            self._cache.last_pause_rtl_publish_at = _utcnow_iso()

    def publish_continue_mission(self) -> None:
        if self._continue_mission_pub is None:
            raise RuntimeError("ROS bridge is not running")
        message = Bool()
        message.data = True
        self._continue_mission_pub.publish(message)
        with self._lock:
            self._cache.last_continue_publish_at = _utcnow_iso()

    def status_snapshot(self) -> StatusSnapshot:
        with self._lock:
            status = self._cache.vehicle_status
            status_age = _age_seconds(self._cache.vehicle_status_time)
            position = self._cache.vehicle_global_position
            position_age = _age_seconds(self._cache.vehicle_global_position_time)
            global_origin = (
                self._cache.global_origin_lat_deg,
                self._cache.global_origin_lon_deg,
                self._cache.global_origin_alt_msl_m,
            )
            local_position = self._cache.vehicle_local_position
            local_position_age = _age_seconds(self._cache.vehicle_local_position_time)
            battery = self._cache.battery_status
            battery_age = _age_seconds(self._cache.battery_status_time)
            mission_runtime = dict(self._cache.mission_runtime or {})
            mission_runtime_age = _age_seconds(self._cache.mission_runtime_time)
            pickup_payload = self._cache.pickup_payload
            pickup_raw = self._cache.pickup_raw
            pickup_age = _age_seconds(self._cache.pickup_time)
            pickup_at = self._cache.pickup_at
            mission_cache = MissionCacheSnapshot(
                loaded=self._cache.item_count > 0,
                mission_name=self._cache.mission_name,
                item_count=self._cache.item_count,
                last_mission_publish_at=self._cache.last_mission_publish_at,
                last_activate_publish_at=self._cache.last_activate_publish_at,
                last_abort_publish_at=self._cache.last_abort_publish_at,
                last_start_publish_at=self._cache.last_start_publish_at,
                last_return_home_publish_at=self._cache.last_return_home_publish_at,
                last_pause_rtl_publish_at=self._cache.last_pause_rtl_publish_at,
                last_continue_publish_at=self._cache.last_continue_publish_at,
            )

        connected = bool(status_age is not None and status_age <= self._settings.vehicle_status_timeout_s)
        frontend_position = _frontend_position_snapshot(
            global_position=position,
            local_position=local_position,
            settings=self._settings,
            global_origin=global_origin,
        )
        battery_percent = None
        if battery is not None and battery.remaining >= 0:
            battery_percent = max(0, min(100, int(round(battery.remaining * 100))))

        return StatusSnapshot(
            ros_ready=self._node is not None and self._thread is not None and self._thread.is_alive(),
            mission_topic=self._settings.mission_topic,
            activate_topic=self._settings.activate_topic,
            pickup_topic=self._settings.pickup_topic,
            pause_rtl_topic=self._settings.pause_rtl_topic,
            continue_mission_topic=self._settings.continue_mission_topic,
            start_topic=self._settings.start_topic,
            return_home_topic=self._settings.return_home_topic,
            vehicle=VehicleSnapshot(
                connected=connected,
                flight_mode=NAV_STATE_NAMES.get(status.nav_state) if status is not None else None,
                nav_state=status.nav_state if status is not None else None,
                executor_in_charge=status.executor_in_charge if status is not None else None,
                armed=bool(
                    status is not None
                    and status.arming_state == VehicleStatus.ARMING_STATE_ARMED
                ),
                preflight_checks_pass=status.pre_flight_checks_pass if status is not None else None,
                failsafe=status.failsafe if status is not None else None,
                system_id=status.system_id if status is not None else None,
                component_id=status.component_id if status is not None else None,
                battery_percent=battery_percent,
                last_status_age_s=status_age,
                last_position_age_s=position_age,
                last_local_position_age_s=local_position_age,
                last_battery_age_s=battery_age,
                position=frontend_position,
            ),
            mission_cache=mission_cache,
            pickup=PickupSnapshot(
                available=pickup_raw is not None,
                payload=pickup_payload,
                raw=pickup_raw,
                last_update_at=pickup_at,
                last_update_age_s=pickup_age,
            ),
            mission_runtime=MissionRuntimeSnapshot(
                available=bool(mission_runtime),
                runtime_state=_optional_str(mission_runtime.get("runtime_state")),
                mission_ready=_optional_bool(mission_runtime.get("mission_ready")),
                mission_active=_optional_bool(mission_runtime.get("mission_active", mission_runtime.get("active"))),
                mission_start_in_progress=_optional_bool(mission_runtime.get("mission_start_in_progress")),
                current_item_index=_optional_int(mission_runtime.get("current_item_index", mission_runtime.get("current_index"))),
                current_item_type=_optional_str(mission_runtime.get("current_item_type")),
                vehicle=_mission_runtime_vehicle_snapshot(mission_runtime.get("vehicle")),
                manual_altitude_active=_optional_bool(mission_runtime.get("manual_altitude_active")),
                altitude_offset_m=_optional_float(mission_runtime.get("altitude_offset_m")),
                throttle_input=_optional_float(mission_runtime.get("throttle_input")),
                climb_rate_command_m_s=_optional_float(mission_runtime.get("climb_rate_command_m_s")),
                target=_target_snapshot(mission_runtime.get("target")),
                payload_servo=_payload_servo_snapshot(mission_runtime.get("payload_servo")),
                pause=_pause_snapshot(mission_runtime.get("pause")),
                last_error=_optional_str(mission_runtime.get("last_error")),
                last_update_age_s=mission_runtime_age,
            ),
        )

    def _spin(self) -> None:
        assert self._executor is not None
        try:
            while not self._stop_event.is_set():
                self._executor.spin_once(timeout_sec=0.1)
        except ExternalShutdownException:
            pass

    def _on_vehicle_status(self, message: VehicleStatus) -> None:
        with self._lock:
            self._cache.vehicle_status = message
            self._cache.vehicle_status_time = time.monotonic()

    def _on_vehicle_global_position(self, message: VehicleGlobalPosition) -> None:
        with self._lock:
            self._cache.vehicle_global_position = message
            self._cache.vehicle_global_position_time = time.monotonic()

            # UI local fallback: PX4 can publish a valid global position while
            # /fmu/out/vehicle_local_position is absent, stale, or stuck around 0.
            # Capture the first valid global sample as a display origin so the
            # frontend can still show X/Y/Z and keep the UAV centered on the map.
            if self._cache.global_origin_lat_deg is None and _has_valid_global_position(message):
                lat = _finite_number(getattr(message, "lat", None))
                lon = _finite_number(getattr(message, "lon", None))
                alt = _finite_number(getattr(message, "alt", None))
                if lat is not None and lon is not None:
                    self._cache.global_origin_lat_deg = lat
                    self._cache.global_origin_lon_deg = lon
                    self._cache.global_origin_alt_msl_m = alt if alt is not None else self._settings.map_origin_alt_msl_m

    def _on_vehicle_local_position(self, message: VehicleLocalPosition) -> None:
        with self._lock:
            self._cache.vehicle_local_position = message
            self._cache.vehicle_local_position_time = time.monotonic()

    def _on_battery_status(self, message: BatteryStatus) -> None:
        with self._lock:
            self._cache.battery_status = message
            self._cache.battery_status_time = time.monotonic()

    def _on_pickup(self, message: String) -> None:
        try:
            payload = json.loads(message.data)
        except json.JSONDecodeError:
            payload = None

        with self._lock:
            self._cache.pickup_raw = message.data
            self._cache.pickup_payload = payload if isinstance(payload, dict) else None
            self._cache.pickup_time = time.monotonic()
            self._cache.pickup_at = _utcnow_iso()

    def _on_mission_runtime(self, message: String) -> None:
        try:
            payload = json.loads(message.data)
        except json.JSONDecodeError:
            payload = {"last_error": "Failed to decode mission runtime JSON"}

        with self._lock:
            self._cache.mission_runtime = payload if isinstance(payload, dict) else {}
            self._cache.mission_runtime_time = time.monotonic()


def _finite_number(value: Any) -> float | None:
    try:
        number = float(value)
    except (TypeError, ValueError):
        return None
    return number if math.isfinite(number) else None


def _has_valid_global_position(position: VehicleGlobalPosition | None) -> bool:
    if position is None:
        return False
    return bool(
        getattr(position, "lat_lon_valid", False)
        and _finite_number(getattr(position, "lat", None)) is not None
        and _finite_number(getattr(position, "lon", None)) is not None
    )


def _local_reference(position: VehicleLocalPosition | None, settings: AppSettings) -> tuple[float, float, float, bool, str]:
    if position is not None:
        ref_lat = _finite_number(getattr(position, "ref_lat", None))
        ref_lon = _finite_number(getattr(position, "ref_lon", None))
        ref_alt = _finite_number(getattr(position, "ref_alt", None))
        if ref_lat is not None and ref_lon is not None:
            return ref_lat, ref_lon, ref_alt if ref_alt is not None else settings.map_origin_alt_msl_m, True, "ROS 2 local ref"

    return (
        settings.map_origin_lat_deg,
        settings.map_origin_lon_deg,
        settings.map_origin_alt_msl_m,
        False,
        "ROS 2 local map origin",
    )


def _ned_offset_to_lat_lon(ref_lat_deg: float, ref_lon_deg: float, north_m: float, east_m: float) -> tuple[float, float]:
    earth_radius_m = 6378137.0
    ref_lat_rad = math.radians(ref_lat_deg)
    latitude = ref_lat_deg + math.degrees(north_m / earth_radius_m)
    lon_scale = max(math.cos(ref_lat_rad), 1e-7)
    longitude = ref_lon_deg + math.degrees(east_m / (earth_radius_m * lon_scale))
    return latitude, longitude


def _lat_lon_to_ned(ref_lat_deg: float, ref_lon_deg: float, latitude_deg: float, longitude_deg: float) -> tuple[float, float]:
    earth_radius_m = 6378137.0
    ref_lat_rad = math.radians(ref_lat_deg)
    north_m = math.radians(latitude_deg - ref_lat_deg) * earth_radius_m
    east_m = math.radians(longitude_deg - ref_lon_deg) * earth_radius_m * max(math.cos(ref_lat_rad), 1e-7)
    return north_m, east_m


def _frontend_position_snapshot(
    *,
    global_position: VehicleGlobalPosition | None,
    local_position: VehicleLocalPosition | None,
    settings: AppSettings,
    global_origin: tuple[float | None, float | None, float | None] = (None, None, None),
) -> PositionSnapshot:
    if _has_valid_global_position(global_position):
        latitude = _finite_number(getattr(global_position, "lat", None))
        longitude = _finite_number(getattr(global_position, "lon", None))
        altitude = _finite_number(getattr(global_position, "alt", None)) if bool(getattr(global_position, "alt_valid", False)) else None

        ref_lat = _finite_number(getattr(local_position, "ref_lat", None)) if local_position is not None else None
        ref_lon = _finite_number(getattr(local_position, "ref_lon", None)) if local_position is not None else None
        ref_alt = _finite_number(getattr(local_position, "ref_alt", None)) if local_position is not None else None

        # Prefer PX4's local reference if available. Otherwise use the first
        # valid global sample captured by the backend. This avoids the UI showing
        # Local X/Y/Z stuck at 0 when only global_position updates.
        if ref_lat is None or ref_lon is None:
            origin_lat, origin_lon, origin_alt = global_origin
            ref_lat = _finite_number(origin_lat)
            ref_lon = _finite_number(origin_lon)
            ref_alt = _finite_number(origin_alt)

        local_x = local_y = local_z = None
        local_xy_valid = False
        local_z_valid = False
        if latitude is not None and longitude is not None and ref_lat is not None and ref_lon is not None:
            local_x, local_y = _lat_lon_to_ned(ref_lat, ref_lon, latitude, longitude)
            local_xy_valid = True
        if altitude is not None and ref_alt is not None:
            local_z = -(altitude - ref_alt)
            local_z_valid = True

        # If the global altitude is not valid, keep PX4 local Z as a fallback.
        if local_z is None and local_position is not None:
            raw_local_z = _finite_number(getattr(local_position, "z", None))
            if raw_local_z is not None:
                local_z = raw_local_z
                local_z_valid = bool(getattr(local_position, "z_valid", False))

        relative_altitude = -local_z if local_z is not None else None

        return PositionSnapshot(
            latitude_deg=latitude,
            longitude_deg=longitude,
            altitude_amsl_m=altitude,
            relative_altitude_m=relative_altitude,
            source="PX4 global_position + derived NED",
            local_x_ned_m=local_x,
            local_y_ned_m=local_y,
            local_z_ned_m=local_z,
            local_heading_rad=_finite_number(getattr(local_position, "heading", None)) if local_position is not None else None,
            local_xy_valid=local_xy_valid,
            local_z_valid=local_z_valid,
            local_reference_valid=ref_lat is not None and ref_lon is not None,
            ref_lat_deg=ref_lat,
            ref_lon_deg=ref_lon,
            ref_alt_msl_m=ref_alt,
        )

    if local_position is None:
        return PositionSnapshot(source="none")

    local_x = _finite_number(getattr(local_position, "x", None))
    local_y = _finite_number(getattr(local_position, "y", None))
    local_z = _finite_number(getattr(local_position, "z", None))
    xy_valid = bool(getattr(local_position, "xy_valid", False)) and local_x is not None and local_y is not None
    z_valid = bool(getattr(local_position, "z_valid", False)) and local_z is not None

    ref_lat, ref_lon, ref_alt, ref_valid, source = _local_reference(local_position, settings)
    latitude = longitude = altitude = relative_altitude = None

    if xy_valid:
        latitude, longitude = _ned_offset_to_lat_lon(ref_lat, ref_lon, local_x, local_y)
    if z_valid:
        relative_altitude = -local_z
        altitude = ref_alt - local_z

    return PositionSnapshot(
        latitude_deg=latitude,
        longitude_deg=longitude,
        altitude_amsl_m=altitude,
        relative_altitude_m=relative_altitude,
        source=source,
        local_x_ned_m=local_x,
        local_y_ned_m=local_y,
        local_z_ned_m=local_z,
        local_heading_rad=_finite_number(getattr(local_position, "heading", None)),
        local_xy_valid=xy_valid,
        local_z_valid=z_valid,
        local_reference_valid=ref_valid,
        ref_lat_deg=ref_lat,
        ref_lon_deg=ref_lon,
        ref_alt_msl_m=ref_alt,
    )


def _optional_str(value: Any) -> str | None:
    if value is None:
        return None
    text = str(value).strip()
    return text if text else None


def _optional_bool(value: Any) -> bool | None:
    if isinstance(value, bool):
        return value
    return None


def _optional_int(value: Any) -> int | None:
    if value is None:
        return None
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def _optional_float(value: Any) -> float | None:
    if value is None:
        return None
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def _target_snapshot(value: Any) -> TargetSnapshot:
    payload = value if isinstance(value, dict) else {}
    return TargetSnapshot(
        valid=_optional_bool(payload.get("valid")),
        x_ned_m=_optional_float(payload.get("x_ned_m")),
        y_ned_m=_optional_float(payload.get("y_ned_m")),
        base_z_ned_m=_optional_float(payload.get("base_z_ned_m")),
        effective_z_ned_m=_optional_float(payload.get("effective_z_ned_m")),
        altitude_offset_m=_optional_float(payload.get("altitude_offset_m")),
    )


def _mission_runtime_vehicle_snapshot(value: Any) -> MissionRuntimeVehicleSnapshot:
    payload = value if isinstance(value, dict) else {}
    return MissionRuntimeVehicleSnapshot(
        valid=_optional_bool(payload.get("valid")),
        armed=_optional_bool(payload.get("armed")),
        landed=_optional_bool(payload.get("landed")),
        nav_state=_optional_int(payload.get("nav_state")),
        x_ned_m=_optional_float(payload.get("x_ned_m")),
        y_ned_m=_optional_float(payload.get("y_ned_m")),
        z_ned_m=_optional_float(payload.get("z_ned_m")),
        local_reference_valid=_optional_bool(payload.get("local_reference_valid")),
        ref_lat_deg=_optional_float(payload.get("ref_lat_deg")),
        ref_lon_deg=_optional_float(payload.get("ref_lon_deg")),
        ref_alt_msl_m=_optional_float(payload.get("ref_alt_msl_m")),
    )


def _pause_snapshot(value: Any) -> PauseSnapshot:
    payload = value if isinstance(value, dict) else {}
    pause_point = payload.get("pause_point") if isinstance(payload.get("pause_point"), dict) else None
    return PauseSnapshot(
        phase=_optional_str(payload.get("phase")),
        paused=_optional_bool(payload.get("paused")),
        has_pause_point=_optional_bool(payload.get("has_pause_point")),
        pause_point=pause_point,
    )


def _payload_servo_snapshot(value: Any) -> PayloadServoSnapshot:
    payload = value if isinstance(value, dict) else {}
    return PayloadServoSnapshot(
        active=_optional_bool(payload.get("active")),
        item_index=_optional_int(payload.get("item_index")),
        channel=_optional_int(payload.get("channel")),
        pwm_us=_optional_int(payload.get("pwm_us")),
        pulse_high=_optional_bool(payload.get("pulse_high")),
    )
